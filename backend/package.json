{
  "name": "football-booking-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "check": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "db:check": "tsx src/scripts/check-db.ts",
    "db:seed": "prisma db seed",
    "test:courts": "npm run prisma:generate && bash ../scripts/check-courts-api.sh",
    "precheck": "npm run prisma:generate",
    "prebuild": "npm run prisma:generate",
    "predb:check": "npm run prisma:generate",
    "predb:seed": "npm run prisma:generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
